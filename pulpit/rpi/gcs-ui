#!/bin/sh
# Przełącznik interfejsu przy starcie maszyny.
#
#   sudo gcs-ui nasze     -> po restarcie wstaje pulpit GCS
#   sudo gcs-ui malina    -> po restarcie wstaje pulpit Raspberry Pi OS
#   sudo gcs-ui stan      -> co jest ustawione teraz
#
# ⛔ DROGA POWROTU, gdy ekran nie odpowiada — przez SSH:
#
#     sudo gcs-ui malina && sudo systemctl restart lightdm
#
# `sshd` jest niezależny od sesji graficznej, więc ta droga działa także wtedy,
# gdy pulpit GCS w ogóle nie wstał. Restart lightdm zrywa sesję na ekranie,
# ale NIE zrywa połączenia SSH.
set -u

KONF=/etc/lightdm/lightdm.conf
PAMIEC=/etc/gcs/sesja-poprzednia
NASZA=gcs

bledem() { echo "BŁĄD: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || bledem "uruchom przez sudo"
[ -f "$KONF" ] || bledem "nie ma $KONF"

teraz() { sed -n 's/^autologin-session=//p' "$KONF" | head -1; }

ustaw() {
  # `autologin-session` wpisujemy w miejscu, w którym już jest — bez dopisywania
  # nowych linii, żeby plik nie puchł przy kolejnych przełączeniach.
  sed -i "s/^autologin-session=.*/autologin-session=$1/" "$KONF"
  [ "$(teraz)" = "$1" ] || bledem "zapis nie wszedł — sprawdź $KONF"
}

case "${1:-stan}" in
  nasze)
    obecna=$(teraz)
    [ -n "$obecna" ] || bledem "nie ma wpisu autologin-session w $KONF"
    if [ "$obecna" != "$NASZA" ]; then
      # Zapamiętujemy RAZ. Drugie przełączenie nie może nadpisać pamięci
      # nazwą „gcs", bo wtedy droga powrotu prowadziłaby donikąd.
      mkdir -p /etc/gcs
      [ -f "$PAMIEC" ] || printf '%s\n' "$obecna" > "$PAMIEC"
    fi
    [ -f /usr/share/wayland-sessions/$NASZA.desktop ] \
      || bledem "brak /usr/share/wayland-sessions/$NASZA.desktop — najpierw instalacja"
    ustaw "$NASZA"
    echo "Po restarcie wstanie pulpit GCS (poprzednia sesja: $(cat "$PAMIEC" 2>/dev/null))"
    echo "Teraz:  sudo systemctl restart lightdm"
    ;;
  malina)
    poprzednia=$(cat "$PAMIEC" 2>/dev/null)
    # Gdyby pamięć przepadła, wracamy do sesji fabrycznej Raspberry Pi OS.
    [ -n "$poprzednia" ] || poprzednia=rpd-labwc
    [ -f "/usr/share/wayland-sessions/$poprzednia.desktop" ] \
      || bledem "nie ma sesji $poprzednia — zajrzyj do /usr/share/wayland-sessions/"
    ustaw "$poprzednia"
    # Pulpit GCS gasimy TU, nie licząc na restart lightdm. Usługa użytkownika
    # przeżywa wymianę sesji graficznej i bez tego zostałaby na wierzchu —
    # sprawdzone, tak właśnie było za pierwszym razem.
    uzytkownik=$(sed -n 's/^autologin-user=//p' "$KONF" | head -1)
    if [ -n "$uzytkownik" ] && id "$uzytkownik" >/dev/null 2>&1; then
      su -l "$uzytkownik" -c         "XDG_RUNTIME_DIR=/run/user/$(id -u "$uzytkownik") systemctl --user stop gcs-pulpit"         >/dev/null 2>&1 || true
      echo "Pulpit GCS zatrzymany"
    fi
    echo "Po restarcie wstanie pulpit Raspberry Pi OS ($poprzednia)"
    echo "Teraz:  sudo systemctl restart lightdm"
    ;;
  stan)
    echo "autologin-session = $(teraz)"
    echo "zapamiętana poprzednia = $(cat "$PAMIEC" 2>/dev/null || echo '(brak)')"
    ;;
  *)
    echo "użycie: $0 nasze|malina|stan" >&2
    exit 2
    ;;
esac
