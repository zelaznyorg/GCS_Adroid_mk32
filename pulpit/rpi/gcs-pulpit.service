; Pulpit GCS — ekran główny stacji naziemnej.
;
; To jest jednostka UŻYTKOWNIKA, nie systemowa: pulpit potrzebuje sesji
; graficznej, której usługa systemowa nie widzi. Instaluje się bez `sudo`.
;
;   systemctl --user enable --now gcs-pulpit
;   sudo loginctl enable-linger admin      # żeby wstawał bez logowania człowieka
[Unit]
Description=Pulpit GCS — ekran główny stacji
Documentation=file:///opt/gcs/dok/UI_PULPIT.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/gcs/pulpit
Environment=PYTHONUNBUFFERED=1
; Na tej malinie nie ma magistrali dostępności; bez tego GTK zasypuje dziennik.
Environment=GTK_A11Y=none
; GCS_PELNY_EKRAN=0 uruchamia w oknie — wygodne przy pracy nad wyglądem.
Environment=GCS_PELNY_EKRAN=1
; ⚠ Bez tego gtk4-layer-shell laduje w dowiazaniach po libwayland i klawiatura
; po cichu staje sie zwyklym oknem — zabiera ognisko i pisze sama do siebie.
Environment=LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgtk4-layer-shell.so.0
ExecStart=/usr/bin/python3 -m gcs_pulpit

; Pasek zadan i pulpit maliny gasna na czas pracy GCS — inaczej widac je spod
; kazdej aplikacji, ktora nie zajmuje calego ekranu. Tapete klade nasza warstwa
; tla. `-` przed poleceniem: gdyby skryptu zabraklo, pulpit i tak ma wstac.
ExecStartPost=-/usr/local/bin/gcs-otoczenie ukryj
; ⛔ ExecStopPost z `przywroc` zostalo USUNIETE 2026-08-29. Powod zmierzony:
; sesja maliny uruchamia pasek i pulpit SAMA, z /etc/xdg/labwc/autostart. Kiedy
; robilismy to jeszcze raz przy zatrzymaniu uslugi, wychodzil wyscig — pcmanfm
; melodowal „Desktop manager is not active", a paska zadan nie bylo wcale.
; Droga powrotu i tak konczy sie restartem lightdm, ktory daje swiezy, kompletny
; pulpit maliny. `gcs-otoczenie przywroc` zostaje do reki, gdy pulpit GCS chodzi
; w sesji maliny (praca nad wygladem) i chcemy pasek z powrotem bez wylogowania.

; Pulpit jest jedyną drogą do aplikacji na tym stanowisku, więc ma wracać
; po awarii. Limit prób w [Unit] chroni przed pętlą przy usterce trwałej.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
